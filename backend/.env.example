# Database
DB_HOST=localhost
DB_PORT=55432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=igreja_escala
DB_LOGGING=false

# Server
PORT=3001
NODE_ENV=development

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
REFRESH_TOKEN_SECRET=your-super-secret-refresh-token-key-change-this

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:8081,http://192.168.1.49:8081

# Redis (optional for future)
REDIS_HOST=localhost
REDIS_PORT=6379

# Seed (npm run db:seed)
SEED_CHURCH_NAME=Igreja Local
SEED_CHURCH_SLUG=igreja-local
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=admin@igrejaescala.local
SEED_ADMIN_PASSWORD=admin1234

# Timezone used in notifications and shared text
APP_TIMEZONE=America/Sao_Paulo

# Mail for password recovery (optional: without SMTP_HOST the code is only logged)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=Igreja Escala <no-reply@example.com>
