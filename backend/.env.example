# ---------------------------------------------------------------
# Banco de dados
# Local (docker-compose): porta 55432, sem SSL.
# Produção (Neon): host SEM "-pooler", DB_PORT=5432 e DB_SSL=true.
# ---------------------------------------------------------------
DB_HOST=localhost
DB_PORT=55432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=igreja_escala
DB_SSL=false
DB_LOGGING=false

# ---------------------------------------------------------------
# Servidor
# No Render a PORT é definida automaticamente.
# ---------------------------------------------------------------
PORT=3001
NODE_ENV=development

# ---------------------------------------------------------------
# JWT (em produção use dois segredos longos e DIFERENTES entre si)
# Gerar: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ---------------------------------------------------------------
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
REFRESH_TOKEN_SECRET=your-super-secret-refresh-token-key-change-this

# ---------------------------------------------------------------
# CORS: endereços do site (PWA/web), separados por vírgula.
# Em produção, o endereço do Vercel, ex.: https://igreja-escala.vercel.app
# O app Android (APK) não depende de CORS.
# ---------------------------------------------------------------
CORS_ORIGIN=http://localhost:3000,http://localhost:8081,http://192.168.1.49:8081

# ---------------------------------------------------------------
# Fuso usado nas notificações e no texto da escala para WhatsApp
# ---------------------------------------------------------------
APP_TIMEZONE=America/Sao_Paulo

# ---------------------------------------------------------------
# E-mail da recuperação de senha (opcional).
# Sem SMTP_HOST o código de 6 dígitos aparece só no log do backend.
# ---------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=Igreja Escala <no-reply@example.com>

# ---------------------------------------------------------------
# Redis (opcional, uso futuro)
# ---------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# ---------------------------------------------------------------
# Seed (npm run db:seed): cria a igreja e o primeiro administrador
# ---------------------------------------------------------------
SEED_CHURCH_NAME=Igreja Local
SEED_CHURCH_SLUG=igreja-local
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=admin@igrejaescala.local
SEED_ADMIN_PASSWORD=admin1234
