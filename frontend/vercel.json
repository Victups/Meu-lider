{
  "installCommand": "npm install --no-audit --no-fund",
  "buildCommand": "npx expo export --platform web",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/events/:eventId", "destination": "/events/[eventId].html" },
    { "source": "/teams/:teamId", "destination": "/teams/[teamId].html" }
  ]
}
